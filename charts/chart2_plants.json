{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Threatened plant species in Malaysia by IUCN category (2024). Source: IUCN Red List 2024.",
  "data": {
    "values": [
      {"category": "Critically Endangered", "count": 35},
      {"category": "Endangered",            "count": 55},
      {"category": "Vulnerable",            "count": 120},
      {"category": "Near Threatened",       "count": 80}
    ]
  },
  "mark": {"type": "arc", "innerRadius": 55, "outerRadius": 110},
  "width": 260,
  "height": 260,
  "encoding": {
    "theta": {"field": "count", "type": "quantitative"},
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": ["Critically Endangered", "Endangered", "Vulnerable", "Near Threatened"],
        "range": ["#c1121f", "#e76f51", "#74c69d", "#2d6a4f"]
      },
      "legend": {"title": "Threat Level", "orient": "right"}
    },
    "tooltip": [
      {"field": "category"},
      {"field": "count", "title": "Plant Species"}
    ]
  }
}
