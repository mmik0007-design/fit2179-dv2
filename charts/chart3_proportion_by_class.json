{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Total threatened animal species in Malaysia by class. Source: IUCN Red List 2024.",
  "data": {
    "values": [
      {"group": "Fish",         "total": 242, "pct": 31.8},
      {"group": "Amphibians",   "total": 95,  "pct": 12.5},
      {"group": "Birds",        "total": 85,  "pct": 11.2},
      {"group": "Reptiles",     "total": 78,  "pct": 10.2},
      {"group": "Insects",      "total": 75,  "pct": 9.9},
      {"group": "Mammals",      "total": 81,  "pct": 10.6},
      {"group": "Molluscs",     "total": 46,  "pct": 6.0},
      {"group": "Other Inverts","total": 59,  "pct": 7.8}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusEnd": 3},
  "width": "container",
  "height": 220,
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "sort": "-y",
      "axis": {"title": null, "labelAngle": 0}
    },
    "y": {
      "field": "total",
      "type": "quantitative",
      "axis": {"title": "Total Threatened Species"}
    },
    "color": {
      "field": "total",
      "type": "quantitative",
      "scale": {"scheme": "greens", "reverse": true},
      "legend": {"title": "Count"}
    },
    "tooltip": [
      {"field": "group",  "title": "Animal Group"},
      {"field": "total",  "title": "Total Threatened"},
      {"field": "pct",    "title": "% of Total", "format": ".1f"}
    ]
  }
}
